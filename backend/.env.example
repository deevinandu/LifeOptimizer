# Copy this file to `.env` (same directory) and fill in real values.
# `.env` is gitignored -- never commit real credentials.
#
# Sends the alert as a plain email to <contact's 10-digit number>@<carrier
# gateway domain> (e.g. 5551234567@vtext.com for Verizon) via your own
# existing email account's SMTP. Requires the contact's carrier to be set
# in the app's Settings screen.
#
# Gmail example (other providers: use their SMTP host/port instead):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USERNAME=youraddress@gmail.com
#   SMTP_PASSWORD=<a Gmail "app password", NOT your normal password --
#                  generate one at https://myaccount.google.com/apppasswords,
#                  which requires 2-Step Verification to be enabled on the
#                  Google account first>
#   SMTP_FROM_EMAIL=youraddress@gmail.com
#
# If these are left unset, the backend falls back to simulated-only contact
# notification (no real message sent) -- it does not error out.

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
